{
  "entities": {
    "Consultation": {
      "title": "Consultation",
      "description": "Consultation request or booking submitted by a client",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of client"
        },
        "email": {
          "type": "string",
          "maxLength": 100,
          "description": "Email address"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Phone number"
        },
        "serviceType": {
          "type": "string",
          "maxLength": 100,
          "description": "Requested architectural or QS service"
        },
        "county": {
          "type": "string",
          "maxLength": 50,
          "description": "County location in Kenya"
        },
        "projectScope": {
          "type": "string",
          "maxLength": 2000,
          "description": "Detailed project description"
        },
        "estimatedBudget": {
          "type": "string",
          "maxLength": 50,
          "description": "Budget tier"
        },
        "preferredDate": {
          "type": "string",
          "maxLength": 50,
          "description": "Preferred consultation date"
        },
        "attachedEstimate": {
          "type": "string",
          "maxLength": 1000,
          "description": "Attached cost calculator estimate note"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Contacted", "Scheduled", "Completed", "Archived"],
          "description": "Status of consultation request"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Auth UID if submitted while signed in"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission ISO timestamp"
        }
      },
      "required": ["fullName", "email", "serviceType", "projectScope", "status", "createdAt"]
    },
    "SavedEstimate": {
      "title": "SavedEstimate",
      "description": "Saved construction cost estimate generated by client",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Project estimate title"
        },
        "buildingType": {
          "type": "string",
          "maxLength": 100,
          "description": "Type of building (e.g. Residential, Commercial)"
        },
        "finishLevel": {
          "type": "string",
          "maxLength": 50,
          "description": "Finishing specification level"
        },
        "grossFloorArea": {
          "type": "number",
          "description": "Area in square meters"
        },
        "estimatedCostKes": {
          "type": "number",
          "description": "Total estimated cost in KES"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Custom notes or location"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Auth UID of creator"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Saved date-time"
        }
      },
      "required": ["buildingType", "finishLevel", "grossFloorArea", "estimatedCostKes", "userId", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Public user profile and account details",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "maxLength": 100,
          "description": "User primary email"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "createdAt"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "Job application submitted by architect, quantity surveyor or engineer with M-Pesa vetting fee verification",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "maxLength": 100,
          "description": "Candidate full name"
        },
        "email": {
          "type": "string",
          "maxLength": 100,
          "description": "Candidate email address"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Candidate phone number"
        },
        "position": {
          "type": "string",
          "maxLength": 100,
          "description": "Position applied for"
        },
        "registrationDetails": {
          "type": "string",
          "maxLength": 100,
          "description": "BORAQS / AAK / EBK registration number or graduate status"
        },
        "experienceYears": {
          "type": "string",
          "maxLength": 30,
          "description": "Years of professional experience"
        },
        "county": {
          "type": "string",
          "maxLength": 50,
          "description": "Preferred work location county"
        },
        "portfolioUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Link to portfolio, LinkedIn, or Google Drive CV"
        },
        "coverNote": {
          "type": "string",
          "maxLength": 1500,
          "description": "Brief qualifications or cover statement"
        },
        "mpesaTransactionCode": {
          "type": "string",
          "maxLength": 50,
          "description": "M-Pesa transaction reference code for KES 350 registration fee"
        },
        "feeAmountKes": {
          "type": "number",
          "description": "Registration fee amount paid (KES 350)"
        },
        "status": {
          "type": "string",
          "enum": ["Pending Verification", "Shortlisted", "Rejected & Refund Pending", "Refund Issued", "Interview Scheduled"],
          "description": "Application status"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Auth UID if submitted while signed in"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission ISO timestamp"
        }
      },
      "required": ["fullName", "email", "phone", "position", "mpesaTransactionCode", "status", "createdAt"]
    }
  },
  "firestore": {
    "/consultations/{consultationId}": {
      "schema": {
        "$ref": "#/entities/Consultation"
      },
      "description": "Client consultation and contact bookings"
    },
    "/estimates/{estimateId}": {
      "schema": {
        "$ref": "#/entities/SavedEstimate"
      },
      "description": "Client saved construction cost estimations"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Registered user accounts"
    },
    "/job_applications/{applicationId}": {
      "schema": {
        "$ref": "#/entities/JobApplication"
      },
      "description": "Architect & QS job applications with KES 350 vetting fee code"
    }
  }
}
